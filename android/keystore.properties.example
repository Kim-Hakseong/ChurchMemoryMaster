# 릴리즈 서명 설정 템플릿.
# 이 파일을 같은 디렉터리에 keystore.properties 로 복사한 뒤 실제 값을 채운다.
# keystore.properties 와 .jks 는 루트 .gitignore 로 제외되어 있다. 절대 커밋 금지.

# church-memory-release.jks 경로 (android/ 기준 상대경로 또는 절대경로)
storeFile=../church-memory-release.jks
storePassword=
# 기존 AAB 의 서명 별칭은 KEY0 (Android Studio 마법사 기본값 key0)
keyAlias=key0
keyPassword=
